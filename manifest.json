{
  "manifest_version": 3,
  "name": "Meet Transcript Export",
  "version": "0.3.2",
  "description": "Захватывает живые субтитры Google Meet, сохраняет их локально и позволяет экспортировать.",
  "permissions": ["storage", "downloads"],
  "host_permissions": ["https://meet.google.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Meet Transcript Export",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "src/options.html",
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["src/storage.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ]
}
